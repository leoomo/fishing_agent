# 智能钓鱼助手环境配置示例
# 复制此文件为 .env 并填入您的API密钥

# 彩云天气 API 密钥 (必需)
# 获取方式: https://www.caiyunapp.com/
CAIYUN_API_KEY=your-caiyun-api-key-here

# 高德地图 API 密钥 (必需)
# 获取方式: https://console.amap.com/dev/key/app
AMAP_API_KEY=your-amap-api-key-here

# ========== 地理编码配置（解决地名歧义） ==========

# 优先匹配的省份（多个地名重名时优先返回此省份的结果）
# 默认: 浙江省
GEOCODE_PRIORITY_PROVINCE=浙江省

# 优先区域的经纬度边界（浙江省范围）
# 经度: 118.0-123.0°E，纬度: 27.0-31.0°N
GEOCODE_LON_MIN=118.0
GEOCODE_LON_MAX=123.0
GEOCODE_LAT_MIN=27.0
GEOCODE_LAT_MAX=31.0

# 智谱AI GLM API 密钥 (推荐)
# 获取方式: https://open.bigmodel.cn/
ANTHROPIC_AUTH_TOKEN=your-zhipu-api-token-here

# 通义千问 API 密钥 (必需，同时用于LLM和Embedding)
# 获取方式: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# OpenAI API 密钥 (可选)
# 获取方式: https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API 密钥 (可选)
# 获取方式: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# 日志级别 (可选，默认为 INFO)
LOG_LEVEL=INFO

# 缓存配置 (可选)
CACHE_TTL=3600

# ========== 向量存储配置（用于路亚装备知识搜索） ==========

# Embedding模型选择
# 可选值: text-embedding-v3 (1024维，推荐) | text-embedding-v2 (1536维)
VECTOR_EMBEDDING_MODEL=text-embedding-v3

# 是否启用懒加载索引（默认: true）
# true: 首次搜索时自动索引 | false: 需要手动运行索引命令
VECTOR_AUTO_INDEX=true

# ========== JWT认证配置（v3.1.1新增） ==========

# JWT密钥 (必需，用于签名Token)
# 请使用强随机字符串，至少32个字符
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-here-min-32-chars

# JWT算法 (可选，默认为 HS256)
# 常用值: HS256 | HS384 | HS512
JWT_ALGORITHM=HS256

# Token过期时间 (可选，默认为60分钟)
# 单位: 分钟，建议值: 30-1440 (30分钟-24小时)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# 管理员用户表名 (可选，默认为 admin_users)
# 如果需要自定义用户表名，请修改此配置
ADMIN_USER_TABLE=admin_users

# ========== 微信小程序配置（微信登录功能） ==========

# 微信小程序 AppID (必需，从微信公众平台获取)
# 获取方式: https://mp.weixin.qq.com/
WECHAT_APPID=your-wechat-appid-here

# 微信小程序 AppSecret (必需，从微信公众平台获取)
# 注意：请勿在客户端代码中暴露此密钥
WECHAT_SECRET=your-wechat-secret-here

# 微信API服务器地址 (可选，默认为官方地址)
WECHAT_API_URL=https://api.weixin.qq.com

# 微信登录Token有效期 (可选，默认为7200秒/2小时)
WECHAT_TOKEN_EXPIRES_IN=7200

# 是否自动创建新用户 (可选，默认为 true)
# true: 微信用户首次登录自动创建用户账号
# false: 微信用户首次登录需要绑定已有账号
WECHAT_AUTO_CREATE_USER=true

# 微信用户默认角色 (可选，默认为 readonly)
# 可选值: admin | editor | readonly
WECHAT_DEFAULT_ROLE=readonly

# ========== OCR 服务配置（支持多种提供商） ==========

# OCR 提供商选择 (可选，默认为 ollama)
# 可选值: ollama (本地) | siliconflow (云端) | baidu (云端) | fallback
# ollama: 使用本地 deepseek-ocr 模型，优先推荐
# siliconflow: 使用硅基流动云端 API
# baidu: 使用百度 AI Studio API
# fallback: 自动按顺序尝试多个提供商（推荐用于生产环境）
OCR_PROVIDER=ollama

# OCR 回退提供商列表（使用 fallback 提供商时生效）
# 按优先级排列，用逗号分隔
# 示例: ollama,siliconflow,baidu (先尝试本地，失败后尝试云端)
OCR_FALLBACK_PROVIDERS=ollama,siliconflow,baidu

# --- Ollama 本地 OCR 配置 ---

# Ollama 服务地址 (可选，默认为 http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama OCR 模型 (可选，默认为 deepseek-ocr)
OLLAMA_MODEL=deepseek-ocr

# Ollama 请求超时时间（秒，默认120，本地处理通常需要更长时间）
OLLAMA_TIMEOUT=120

# Ollama 最大图片大小（字节，默认20MB）
OLLAMA_MAX_SIZE=20971520

# --- 硅基流动云端 OCR 配置 ---

# 硅基流动 API 密钥 (使用 siliconflow 提供商时必需)
# 获取方式: https://siliconflow.cn/
SILICONFLOW_API_KEY=your-siliconflow-api-key-here

# SiliconFlow OCR 请求超时时间（秒，默认30）
SILICONFLOW_OCR_TIMEOUT=30

# SiliconFlow OCR 最大图片大小（字节，默认10MB）
SILICONFLOW_OCR_MAX_SIZE=10485760

# --- 百度云端 OCR 配置 ---

# 百度 OCR Token (使用 baidu 提供商时推荐配置)
# 默认使用内置 Token，也可以自定义
# 获取方式: 百度 AI Studio
BAIDU_OCR_TOKEN=2bd26c0083441cc29419808330b3dc3ac0504376

# 百度 OCR 请求超时时间（秒，默认30）
BAIDU_OCR_TIMEOUT=30

# 百度 OCR 最大图片大小（字节，默认10MB）
BAIDU_OCR_MAX_SIZE=10485760

#================================================
# 日志配置
#================================================

# 是否将日志写入文件（默认: true）
LOG_TO_FILE=true

# 日志级别（DEBUG, INFO, WARNING, ERROR, CRITICAL，默认: INFO）
LOG_LEVEL=INFO