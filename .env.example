# 智能钓鱼助手环境配置示例
# 复制此文件为 .env 并填入您的API密钥

# 彩云天气 API 密钥 (必需)
# 获取方式: https://www.caiyunapp.com/
CAIYUN_API_KEY=your-caiyun-api-key-here

# 高德地图 API 密钥 (必需)
# 获取方式: https://console.amap.com/dev/key/app
AMAP_API_KEY=your-amap-api-key-here

# ========== 地理编码配置（解决地名歧义） ==========

# 优先匹配的省份（多个地名重名时优先返回此省份的结果）
# 默认: 浙江省
GEOCODE_PRIORITY_PROVINCE=浙江省

# 优先区域的经纬度边界（浙江省范围）
# 经度: 118.0-123.0°E，纬度: 27.0-31.0°N
GEOCODE_LON_MIN=118.0
GEOCODE_LON_MAX=123.0
GEOCODE_LAT_MIN=27.0
GEOCODE_LAT_MAX=31.0

# 智谱AI GLM API 密钥 (推荐)
# 获取方式: https://open.bigmodel.cn/
ANTHROPIC_AUTH_TOKEN=your-zhipu-api-token-here

# 通义千问 API 密钥 (必需，同时用于LLM和Embedding)
# 获取方式: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# OpenAI API 密钥 (可选)
# 获取方式: https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API 密钥 (可选)
# 获取方式: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# 日志级别 (可选，默认为 INFO)
LOG_LEVEL=INFO

# 缓存配置 (可选)
CACHE_TTL=3600

# ========== 向量存储配置（用于路亚装备知识搜索） ==========

# Embedding模型选择
# 可选值: text-embedding-v3 (1024维，推荐) | text-embedding-v2 (1536维)
VECTOR_EMBEDDING_MODEL=text-embedding-v3

# 是否启用懒加载索引（默认: true）
# true: 首次搜索时自动索引 | false: 需要手动运行索引命令
VECTOR_AUTO_INDEX=true